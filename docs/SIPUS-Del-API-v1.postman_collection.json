	"item": [
		{
			"name": "1. SOAP WSDL dan SOAP Request",
			"item": [
				{
					"name": "1.1 GET WSDL Contract",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/soap/sipus.wsdl",
							"host": ["{{base_url}}"],
							"path": ["soap", "sipus.wsdl"]
						},
						"description": "Mendapatkan dokumen kontrak XML WSDL untuk layanan SOAP SIPUS-Del."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Content-Type is XML\", function () {",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/xml\");",
									"});",
									"pm.test(\"WSDL contains CheckClearanceStatus definition\", function () {",
									"    pm.expect(pm.response.text()).to.include(\"CheckClearanceStatus\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "1.2 POST SOAP Clearance Check (Valid)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "text/xml; charset=utf-8"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:sip=\"http://sipus.del.ac.id/soap\">\n    <soapenv:Header/>\n    <soapenv:Body>\n        <sip:CheckClearanceStatusRequest>\n            <sip:nim_peminjam>12S24012</sip:nim_peminjam>\n        </sip:CheckClearanceStatusRequest>\n    </soapenv:Body>\n</soapenv:Envelope>"
						},
						"url": {
							"raw": "{{base_url}}/soap/sipus",
							"host": ["{{base_url}}"],
							"path": ["soap", "sipus"]
						},
						"description": "Mengirimkan SOAP Envelope untuk memeriksa status bebas pustaka mahasiswa berdasarkan NIM."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"SOAP Response contains active_loans and is_cleared\", function () {",
									"    var xml = pm.response.text();",
									"    pm.expect(xml).to.include(\"active_loans\");",
									"    pm.expect(xml).to.include(\"is_cleared\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "2. SOAP Fault",
			"item": [
				{
					"name": "2.1 POST SOAP Fault - Malformed XML",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "text/xml; charset=utf-8"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "<soapenv:Envelope><soapenv:Body><unclosedTag></soapenv:Body>"
						},
						"url": {
							"raw": "{{base_url}}/soap/sipus",
							"host": ["{{base_url}}"],
							"path": ["soap", "sipus"]
						},
						"description": "Menguji respons SOAP Fault pada payload XML yang rusak (malformed)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 400\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"pm.test(\"SOAP Fault structure returned\", function () {",
									"    pm.expect(pm.response.text()).to.include(\"soapenv:Fault\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "2.2 POST SOAP Fault - Missing NIM",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "text/xml; charset=utf-8"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:sip=\"http://sipus.del.ac.id/soap\">\n    <soapenv:Body>\n        <sip:CheckClearanceStatusRequest>\n            <sip:wrong_element>12S24012</sip:wrong_element>\n        </sip:CheckClearanceStatusRequest>\n    </soapenv:Body>\n</soapenv:Envelope>"
						},
						"url": {
							"raw": "{{base_url}}/soap/sipus",
							"host": ["{{base_url}}"],
							"path": ["soap", "sipus"]
						},
						"description": "Menguji respons SOAP Fault saat elemen nim_peminjam tidak ditemukan."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 400\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"pm.test(\"SOAP Fault indicates missing NIM\", function () {",
									"    pm.expect(pm.response.text()).to.include(\"Elemen nim_peminjam tidak ditemukan\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "3. API Login",
			"item": [
				{
					"name": "3.1 POST Login Pustakawan (Sukses)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"pustakawan@del.ac.id\",\n    \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Autentikasi pustakawan dan otomatis menyimpan token ke environment variable Postman."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"Login successful and token returned\", function () {",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data.token).to.not.be.empty;",
									"    pm.environment.set(\"token\", jsonData.data.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "3.2 POST Login Password Salah (401 RFC 7807)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"pustakawan@del.ac.id\",\n    \"password\": \"wrong-password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Menguji penolakan autentikasi saat kata sandi salah dengan format RFC 7807."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 401\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"pm.test(\"Content-Type is application/problem+json\", function () {",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
									"});",
									"var json = pm.response.json();",
									"pm.test(\"RFC 7807 fields present\", function () {",
									"    pm.expect(json.title).to.eql(\"Unauthorized\");",
									"    pm.expect(json.status).to.eql(401);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "4. API Me dan Logout",
			"item": [
				{
					"name": "4.1 GET Profil Pustakawan (Me)",
