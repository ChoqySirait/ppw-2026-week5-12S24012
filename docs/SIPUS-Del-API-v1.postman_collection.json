						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/me",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "me"]
						},
						"description": "Mengambil identitas pustakawan yang sedang aktif menggunakan Bearer Token."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var json = pm.response.json();",
									"pm.test(\"Returns user identity without password\", function () {",
									"    pm.expect(json.data.email).to.not.be.empty;",
									"    pm.expect(json.data).to.not.have.property(\"password\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "4.2 POST Logout (Revoke Token)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "logout"]
						},
						"description": "Mencabut token aktif pustakawan (revocation)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var json = pm.response.json();",
									"pm.test(\"Token revoked successfully\", function () {",
									"    pm.expect(json.success).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "5. GET katalog dan pagination",
			"item": [
				{
					"name": "5.1 GET Katalog Buku (Search, Filter, Sort, Pagination)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/bukus?search=&kategori_id=&tersedia=1&sort=judul&direction=asc&per_page=10",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "bukus"],
							"query": [
								{"key": "search", "value": ""},
								{"key": "kategori_id", "value": ""},
								{"key": "tersedia", "value": "1"},
								{"key": "sort", "value": "judul"},
								{"key": "direction", "value": "asc"},
								{"key": "per_page", "value": "10"}
							]
						},
						"description": "Mengambil katalog buku publik dengan dukungan pencarian, filter stok, pengurutan, metadata pagination, dan tautan HATEOAS."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var json = pm.response.json();",
									"pm.test(\"Pagination meta and links present\", function () {",
									"    pm.expect(json).to.have.property(\"meta\");",
									"    pm.expect(json).to.have.property(\"links\");",
									"});",
									"if (json.data.length > 0) {",
									"    pm.environment.set(\"book_id\", json.data[0].id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
